            "name": "Amazon IAM Access Analyzer Get Generated Policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://access-analyzer.{region}.amazonaws.com/policy/generation/:jobId",
            "headers": [

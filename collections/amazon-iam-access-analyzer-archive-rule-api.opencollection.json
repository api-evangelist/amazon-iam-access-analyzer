{
  "opencollection": "1.0.0",
  "info": {
    "name": "Access Analyzer Access Preview#analyzerArn Archive Rule API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
